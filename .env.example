# GEMINI_API_KEY: Required for Gemini Live WebSocket server (server-side only)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_LIVE_MODEL: Optional — defaults to gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"
# GEMINI_VOICE_NAME: Voix Nova (Aoede, Kore, Puck, Zephyr, Charon, Fenrir…)
# GEMINI_VOICE_NAME="Aoede"

# VITE_GEMINI_API_KEY: Required for Gemini Multimodal Live API (client-side)
# Obtiens ta clé sur: https://aistudio.google.com/apikey
# ⚠️  ATTENTION: Cette clé sera exposée côté client. Utilise les restrictions d'API
# dans Google Cloud Console pour limiter l'usage (domaines autorisés, quotas, etc.)
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# ⚠️  SERVER-SIDE ONLY — Never expose to the browser / client bundle!
# Found in: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# LIVEKIT
VITE_LIVEKIT_URL="wss://YOUR_PROJECT.livekit.cloud"
VITE_LIVEKIT_API_KEY="YOUR_API_KEY"
LIVEKIT_API_SECRET="YOUR_API_SECRET"

# WEB PUSH NOTIFICATIONS (VAPID)
# Génère une paire de clés avec: npx web-push generate-vapid-keys
# La clé publique va ici (côté client)
VITE_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
# La clé privée va dans les Edge Functions Supabase (jamais côté client)
# VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
